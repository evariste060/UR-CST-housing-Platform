{
  "name": "@urcst/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "~6.19.0",
    "@urcst/shared": "*",
    "bcrypt": "^6.0.0",
    "dotenv": "^17.0.0",
    "express": "^5.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/supertest": "^6.0.0",
    "prisma": "~6.19.0",
    "supertest": "^7.1.0",
    "tsx": "^4.23.15",
    "vitest": "^5.1.0"
  }
}
