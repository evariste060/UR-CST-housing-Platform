# Copy to apps/api/.env
PORT=4000
# Port 5433 matches DB_PORT in the root .env.example.
DATABASE_URL=postgresql://urcst:urcst_dev@localhost:5433/urcst_housing?schema=public
# Signs login sessions. Use at least 32 random characters and keep it private.
JWT_SECRET=replace-with-at-least-32-random-characters
# The web address used in password reset links.
WEB_ORIGIN=http://localhost:5173
# Optional. The database npm test uses. Its name must end in _test.
# TEST_DATABASE_URL=postgresql://urcst:urcst_dev@localhost:5433/urcst_housing_test?schema=public
